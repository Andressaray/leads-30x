{
  "name": "leads-colombia",
  "version": "2.0.0",
  "private": true,
  "description": "Leads Colombia monorepo: API (Express + Prisma) and frontend (React Router v8).",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @leads-colombia/api dev",
    "dev:web": "pnpm --filter @leads-colombia/web dev",
    "build": "pnpm --filter @leads-colombia/web build && pnpm --filter @leads-colombia/api build",
    "start": "pnpm --filter @leads-colombia/api start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r test",
    "test:web": "pnpm --filter @leads-colombia/web test",
    "test:unit": "pnpm --filter @leads-colombia/api test:unit && pnpm --filter @leads-colombia/web test",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @leads-colombia/api db:migrate",
    "db:deploy": "pnpm --filter @leads-colombia/api db:deploy",
    "db:generate": "pnpm --filter @leads-colombia/api db:generate",
    "db:seed": "pnpm --filter @leads-colombia/api db:seed",
    "db:test:deploy": "pnpm --filter @leads-colombia/api db:test:deploy"
  }
}
