{
  "name": "@leads-colombia/api",
  "version": "2.0.0",
  "description": "API that searches leads by city in Colombia (DANE, OpenStreetMap, RNT, SECOP II, REPS), matches them and stores them without duplicates in PostgreSQL.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:test:deploy": "dotenv -e .env.test -- prisma migrate deploy",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --testPathIgnorePatterns \"/repository/\" \"/e2e/\"",
    "test:repo": "jest --runInBand \"/repository/|/e2e/\""
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsc-alias": "^1.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
}
