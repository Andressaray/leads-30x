# Disposable database for the repository and end-to-end tests (it is emptied on every test).
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/leads_test
# The same URL, so "pnpm db:test:deploy" applies the migrations to the test database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leads_test
# Session signing key for the tests (any string of 32+ characters).
JWT_SECRET=testing-testing-testing-testing-testing
