// Single source of truth for the data model.
// Convention: PascalCase singular models, snake_case tables and columns.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Every search that was run (city + category) and its summary.
model Search {
  id                Int       @id @default(autoincrement())
  cityText          String?   @map("city_text")
  departmentText    String?   @map("department_text")
  municipalityCode  String    @map("municipality_code") @db.Char(5)
  municipality      String
  department        String
  category          String?
  filters           Json
  requestedSources  String[]  @map("requested_sources")
  status            String    @default("in_progress")
  summary           Json?
  finishedAt        DateTime? @map("finished_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  sources     SearchSource[]
  leads       SearchLead[]
  occurrences Occurrence[]
  originLeads Lead[]

  @@index([municipalityCode])
  @@map("searches")
}

/// Result of each source within a search (records, new, errors, time).
model SearchSource {
  searchId   Int      @map("search_id")
  source     String
  status     String
  records    Int      @default(0)
  new        Int      @default(0)
  enriched   Int      @default(0)
  unchanged  Int      @default(0)
  skipped    Int      @default(0)
  durationMs Int?     @map("duration_ms")
  error      String?
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  search Search @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@id([searchId, source])
  @@index([searchId])
  @@map("search_sources")
}

/// A business, already deduplicated across all sources.
model Lead {
  id               Int      @id @default(autoincrement())
  name             String
  tradeName        String?  @map("trade_name")
  legalName        String?  @map("legal_name")
  /// name + legal name + trade name, without accents or uppercase (for searching)
  namesNorm        String   @default("") @map("names_norm")
  nit              String?
  municipalityCode String   @map("municipality_code") @db.Char(5)
  municipality     String
  department       String
  address          String?
  addressNorm      String?  @map("address_norm")
  lat              Float?
  lon              Float?
  ciiu             String?
  sourceCategory   String?  @map("source_category")
  categories       String[] @default([])
  /// [{ number: "+573001234567", type: "mobile" | "landline", whatsapp?: true }]
  phones           Json     @default("[]")
  emails           String[] @default([])
  websites         String[] @default([])
  socialLinks      String[] @default([]) @map("social_links")
  primaryChannel   String?  @map("primary_channel")
  contactable      Boolean  @default(false)
  contacted        Boolean   @default(false)
  contactedAt      DateTime? @map("contacted_at")
  /// User who made the first approach (assigned when they press "Contact").
  contactedById    Int?      @map("contacted_by_id")
  /// Contact funnel: PENDING → CONTACTED → REPLIED / INTERESTED / NOT_INTERESTED / BOUNCED.
  contactStatus    ContactStatus @default(PENDING) @map("contact_status")
  /// Last message or call the team made to them.
  lastContactedAt  DateTime? @map("last_contacted_at")
  /// First time they replied (to measure the reply rate).
  repliedAt        DateTime? @map("replied_at")
  /// Asked not to be contacted again (Ley 1581 and Ley 2300): blocks every message.
  doNotContact     Boolean   @default(false) @map("do_not_contact")
  doNotContactAt   DateTime? @map("do_not_contact_at")
  /// Latest qualification (Dapta or manual): HIGH, MEDIUM, LOW or DISCARDED.
  quality          LeadQuality?
  /// 0–100 score of the latest qualification, if it came with one.
  score            Int?
  qualifiedAt      DateTime? @map("qualified_at")
  isIndividual     Boolean? @map("is_individual")
  sources          String[] @default([])
  sourceCount      Int      @default(1) @map("source_count")
  originSource     String   @map("origin_source")
  originSearchId   Int?     @map("origin_search_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  originSearch   Search?         @relation(fields: [originSearchId], references: [id], onDelete: SetNull)
  contactedBy    User?           @relation(fields: [contactedById], references: [id], onDelete: SetNull)
  keys           LeadKey[]
  occurrences    Occurrence[]
  searches       SearchLead[]
  interactions   Interaction[]
  qualifications Qualification[]

  @@index([municipalityCode, lat, lon])
  @@index([municipalityCode, addressNorm])
  @@index([nit])
  @@index([contactable])
  @@index([contacted])
  @@index([contactedById])
  @@index([contactStatus])
  @@index([quality])
  @@index([createdAt])
  @@index([originSearchId])
  @@map("leads")
}

/// Strong keys used to deduplicate: NIT, phone, email, web domain.
model LeadKey {
  type      String
  value     String
  leadId    Int      @map("lead_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@id([type, value])
  @@index([leadId])
  @@map("lead_keys")
}

/// Every time a source returned a business and how it was matched to the lead.
/// created_at = first time it was seen; updated_at = last time.
model Occurrence {
  id         Int      @id @default(autoincrement())
  leadId     Int      @map("lead_id")
  source     String
  externalId String   @map("external_id")
  match      String
  data       Json?
  searchId   Int?     @map("search_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  lead   Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  search Search? @relation(fields: [searchId], references: [id], onDelete: SetNull)

  @@unique([source, externalId])
  @@index([leadId])
  @@index([searchId])
  @@map("occurrences")
}

/// Which leads each search brought and with what result (new, enriched, unchanged).
model SearchLead {
  searchId  Int      @map("search_id")
  leadId    Int      @map("lead_id")
  source    String
  result    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  search Search @relation(fields: [searchId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@id([searchId, leadId, source])
  @@index([searchId])
  @@index([leadId])
  @@map("search_leads")
}

enum Role {
  SERVICE
  ADMIN
}

/// People who use the app. The password is stored only as a bcrypt hash.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  fullName     String   @map("full_name")
  role         Role     @default(SERVICE)
  passwordHash String   @map("password_hash")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  contactedLeads Lead[]
  interactions   Interaction[]
  templates      Template[]
  qualifications Qualification[]
  costs          Cost[]
  sources        Source[]

  @@map("users")
}

enum ContactStatus {
  PENDING
  CONTACTED
  REPLIED
  INTERESTED
  NOT_INTERESTED
  BOUNCED
}

enum ContactChannel {
  EMAIL
  WHATSAPP
  CALL
  OTHER
  /// Call made by Dapta's voice agent (counts as a call under Ley 2300).
  DAPTA
}

enum InteractionDirection {
  /// The team wrote to or called the lead.
  OUTBOUND
  /// The lead replied (or the email bounced).
  INBOUND
}

enum InteractionStatus {
  /// The email went out through SMTP.
  SENT
  /// Development mode without SMTP: it was recorded but not sent.
  SIMULATED
  /// The mail server rejected it.
  FAILED
  /// Recorded by hand (WhatsApp, call, reply).
  RECORDED
}

/// Contact history of a lead: every message sent, call made or reply received.
model Interaction {
  id          Int                  @id @default(autoincrement())
  leadId      Int                  @map("lead_id")
  userId      Int?                 @map("user_id")
  channel     ContactChannel
  direction   InteractionDirection
  status      InteractionStatus
  /// Email address or phone number the message went to.
  destination String?
  subject     String?
  message     String?
  note        String?
  /// On inbound interactions: how the lead replied.
  result      ContactStatus?
  error       String?
  /// Message id on the mail server.
  providerId  String?              @map("provider_id")
  templateId  Int?                 @map("template_id")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([templateId])
  @@index([channel, createdAt])
  @@map("interactions")
}

/// Reusable messages with variables ({{name}}, {{municipality}}…).
model Template {
  id          Int            @id @default(autoincrement())
  name        String
  channel     ContactChannel
  /// Email only.
  subject     String?
  body        String
  active      Boolean        @default(true)
  createdById Int?           @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  interactions Interaction[]

  @@index([createdById])
  @@index([channel, active])
  @@map("templates")
}

enum LeadQuality {
  HIGH
  MEDIUM
  LOW
  /// Not a possible customer (does not apply, wrong number, closed…).
  DISCARDED
}

enum QualificationOrigin {
  DAPTA
  MANUAL
}

enum QualificationStatus {
  /// Sent to Dapta, waiting for the result.
  SENT
  /// No DAPTA_FLOW_URL in development: it was recorded but not sent.
  SIMULATED
  /// Dapta did not receive the lead.
  FAILED
  /// The qualification arrived.
  QUALIFIED
  /// Dapta could not reach the lead (no answer, voicemail).
  NO_CONTACT
}

/// Every dispatch to Dapta (and its result) or manual qualification of a lead.
model Qualification {
  id          Int                 @id @default(autoincrement())
  leadId      Int                 @map("lead_id")
  userId      Int?                @map("user_id")
  origin      QualificationOrigin
  status      QualificationStatus
  /// Id sent to Dapta that comes back in the webhook to match the result.
  reference   String              @unique
  quality     LeadQuality?
  score       Int?
  summary     String?
  /// Variables Dapta extracted from the call (whatever the flow is configured to return).
  variables   Json?
  callId      String?             @map("call_id")
  error       String?
  qualifiedAt DateTime?           @map("qualified_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([status])
  @@map("qualifications")
}

enum CostType {
  /// Money that was paid (server, email provider, Dapta…).
  EXPENSE
  /// Team hours × hourly rate.
  HOURS
}

/// What each channel cost in a period. "general" is split among sources according to the leads each one brought.
model Cost {
  id          Int       @id @default(autoincrement())
  /// dane, osm, rnt, secop, reps (sources) · email, whatsapp, call, dapta (contact) · general
  channel     String
  type        CostType  @default(EXPENSE)
  description String
  /// Colombian pesos. For HOURS = hours × hourlyRate.
  amount      Decimal   @db.Decimal(14, 2)
  hours       Decimal?  @db.Decimal(8, 2)
  hourlyRate  Decimal?  @db.Decimal(12, 2) @map("hourly_rate")
  /// Period the cost covers (dates, inclusive).
  from        DateTime  @db.Date
  to          DateTime  @db.Date
  createdById Int?      @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([channel])
  @@index([from, to])
  @@index([createdById])
  @@map("costs")
}

enum SourceType {
  /// Coded in services/sources (DANE, OSM, RNT, SECOP, REPS): it can only be enabled or disabled.
  BUILT_IN
  /// datos.gov.co dataset added by the team, without code.
  OPEN_DATA
}

/// Sources where leads are searched. Searches only query the active ones.
model Source {
  /// Short identifier: "dane", "camara_comercio_cali"…
  key         String     @id
  name        String
  description String     @default("")
  /// What contact data it provides (text for the team).
  contact     String?
  link        String?
  type        SourceType @default(OPEN_DATA)
  active      Boolean    @default(true)
  /// OPEN_DATA only: dataset id on datos.gov.co ("abcd-1234").
  dataset     String?
  /// OPEN_DATA only: which column holds each field (municipality, name, nit, phones…).
  fields      Json?
  /// OPEN_DATA only: extra SoQL condition (e.g. estado='ACTIVO').
  condition   String?
  /// OPEN_DATA only: categories where it is queried ("*" = all of them). Empty = only in "All businesses".
  categories  String[]   @default([])
  createdById Int?       @map("created_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([createdById])
  @@map("sources")
}
