# PostgreSQL database (with docker compose: postgresql://postgres:postgres@localhost:5432/leads)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leads

PORT=3000
API_PREFIX=/api
NODE_ENV=development
LOG_LEVEL=info

# Session signing key (login). Required, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long the session lasts before asking to log in again (format 12h, 7d…).
JWT_EXPIRES_IN=12h

# Initial password of the users created by the seed (pnpm db:seed). Default: Andres1234*
# SEED_PASSWORD=

# A contact email or URL: Overpass (OpenStreetMap) asks clients to identify themselves.
CONTACT=

# Optional: free datos.gov.co token to raise the query limit (RNT, SECOP, REPS).
DATOS_GOV_APP_TOKEN=

# --- Lead outreach (email, WhatsApp, calls) ---
# SMTP to send the emails (Gmail/Workspace, Brevo, Amazon SES, Mailgun…).
# Without SMTP_HOST: in development emails are recorded as "simulated" (not sent); in production they are not sent.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false            # true only with port 465
# SMTP_USER=
# SMTP_PASS=
# Sender. Use a domain of yours with SPF and DKIM set up so it does not end up in spam.
# EMAIL_FROM="Ventas Mi Empresa <ventas@miempresa.co>"
# Where replies arrive. Empty: to the email of the salesperson who sent it.
# EMAIL_REPLY_TO=
# Name that signs the messages (Ley 2300 requires identifying the sender).
COMPANY_NAME=
# Public URL of this API: with it, emails carry the "I do not want more messages" link
# (and the "Unsubscribe" button in Gmail/Outlook). Without it, they ask the recipient to reply BAJA.
# PUBLIC_URL=https://leads.miempresa.co
# Hours and frequency of Ley 2300 de 2023 (Mon-Fri 7–19, Sat 8–15, no Sundays or holidays,
# one contact per day and one channel per week). Set it to false only to test in development.
CONTACT_LEGAL_HOURS=true

# --- Lead qualification with Dapta ---
# Trigger URL of the Flow Studio flow ("Public Route", with the authentication included in the URL).
# Without it: in development dispatches are simulated (recorded, not sent); in production they are not sent.
# DAPTA_FLOW_URL=
# Secret the flow must send to the webhook POST /api/dapta/webhook (x-dapta-secret header,
# Authorization: Bearer or ?token=). Without it, the webhook accepts no results. Generate a long random one.
# DAPTA_WEBHOOK_SECRET=
# true if the flow calls the lead (the contact rules and Ley 2300 apply); false if it only qualifies with the data.
DAPTA_CALLS=true
# DAPTA_TIMEOUT_MS=15000

# Per-minute, per-IP limits
RATE_LIMIT_PER_MINUTE=120
SEARCHES_PER_MINUTE=6
# LOGIN_PER_MINUTE=10

# Optional
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# OSM_TIMEOUT_MS=60000          # maximum wait per Overpass server
# OSM_BUDGET_MS=100000          # maximum total wait for OSM (all retries)
# OSM_RETRY_PAUSE_MS=1000
# OSM_FALLBACK_RADIUS_M=4000
# DANE_TIMEOUT_MS=60000
# DANE_PARALLEL_QUERIES=3
# DANE_RETRY_PAUSE_MS=1500
# SOURCE_MAX_MS=150000          # wait limit of any source within a search
# SOURCE_CACHE_MINUTES=1440     # per-source results cache (0 = no cache)
# SOURCE_CACHE_MAX=100
# DATOS_GOV_TIMEOUT_MS=60000
# DATOS_GOV_MAX_RECORDS=20000
