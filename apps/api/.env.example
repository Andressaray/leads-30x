# Base de datos PostgreSQL (con docker compose: postgresql://postgres:postgres@localhost:5432/leads)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leads

PORT=3000
API_PREFIX=/api
NODE_ENV=development
LOG_LEVEL=info

# Firma de las sesiones (login). Obligatoria, mínimo 32 caracteres aleatorios. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Cuánto dura la sesión antes de pedir login otra vez (formato 12h, 7d…).
JWT_EXPIRES_IN=12h

# Contraseña inicial de los usuarios que crea el seed (pnpm db:seed). Por defecto: Andres1234*
# SEED_PASSWORD=

# Un correo o URL de contacto: Overpass (OpenStreetMap) pide identificar a quien consulta.
CONTACTO=

# Opcional: token gratuito de datos.gov.co para subir el límite de consultas (RNT, SECOP, REPS).
DATOS_GOV_APP_TOKEN=

# --- Contactar leads (correo, WhatsApp, llamadas) ---
# SMTP para enviar los correos (Gmail/Workspace, Brevo, Amazon SES, Mailgun…).
# Sin SMTP_HOST: en desarrollo los correos se registran como "simulados" (no salen); en producción no se envían.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false            # true solo con el puerto 465
# SMTP_USER=
# SMTP_PASS=
# Remitente. Usa un dominio tuyo con SPF y DKIM configurados para no caer en spam.
# CORREO_REMITENTE="Ventas Mi Empresa <ventas@miempresa.co>"
# A dónde llegan las respuestas. Sin valor: al correo del vendedor que envió.
# CORREO_RESPONDER_A=
# Nombre que firma los mensajes (la Ley 2300 pide identificar a quien envía).
NOMBRE_EMPRESA=
# URL pública de esta API: con ella los correos llevan el enlace de "no quiero más mensajes"
# (y el botón "Cancelar suscripción" de Gmail/Outlook). Sin ella, piden responder BAJA.
# URL_PUBLICA=https://leads.miempresa.co
# Horario y frecuencia de la Ley 2300 de 2023 (L-V 7–19, sáb 8–15, sin domingos ni festivos,
# un contacto por día y un canal por semana). Ponlo en false solo para probar en desarrollo.
CONTACTO_HORARIO_LEGAL=true

# --- Calificar leads con Dapta ---
# URL del trigger del flujo en Flow Studio ("Public Route", con la autenticación incluida en la URL).
# Sin ella: en desarrollo los envíos se simulan (se registran, no salen); en producción no se envían.
# DAPTA_FLOW_URL=
# Secreto que el flujo debe mandar al webhook POST /api/dapta/webhook (cabecera x-dapta-secret,
# Authorization: Bearer o ?token=). Sin él, el webhook no acepta resultados. Genera uno largo y aleatorio.
# DAPTA_WEBHOOK_SECRET=
# true si el flujo llama al lead (aplican las reglas de contacto y la Ley 2300); false si solo califica con los datos.
DAPTA_CONTACTA=true
# DAPTA_TIMEOUT_MS=15000

# Límites por minuto y por IP
RATE_LIMIT_POR_MINUTO=120
BUSQUEDAS_POR_MINUTO=6

# Opcionales
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# OSM_TIMEOUT_MS=60000          # espera máxima por cada servidor de Overpass
# OSM_PRESUPUESTO_MS=100000     # espera máxima total de OSM (todos los reintentos)
# OSM_PAUSA_REINTENTO_MS=1000
# OSM_RADIO_RESPALDO_M=4000
# DANE_TIMEOUT_MS=60000
# DANE_CONSULTAS_EN_PARALELO=3
# FUENTE_MAX_MS=150000          # tope de espera de cualquier fuente dentro de una búsqueda
# CACHE_FUENTES_MINUTOS=1440    # caché de resultados por fuente (0 = sin caché)
# CACHE_FUENTES_MAX=100
# DATOS_GOV_MAX_REGISTROS=20000
